# Backend Configuration
PROJECT_NAME="ForenSight"
API_V1_STR="/api/v1"

# Local Compose defaults. Set ENVIRONMENT=production only after replacing these values.
ENVIRONMENT=development
SECRET_KEY=local-development-key-change-before-deployment-32-chars-minimum
POSTGRES_USER=forensight
POSTGRES_PASSWORD=local-dev-password-change-me
POSTGRES_DB=forensight
REDIS_PASSWORD=local-dev-redis-password-change-me
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_REFRESH_EXPIRE_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Optional Ed25519 private key for signed .forensight case exports (base64 encoded 32-byte key).
CASE_EXPORT_SIGNING_PRIVATE_KEY=

# Persistent Storage Configuration ("local" for dev/tests; "s3" required for production ephemeral hosts)
STORAGE_BACKEND=local
STORAGE_DIR=storage/evidence
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_ADDRESSING_STYLE=auto

# Frontend Configuration
VITE_API_URL=""

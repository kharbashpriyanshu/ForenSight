# ForenSight Backend Configuration

# API Settings
API_V1_STR=/api
PROJECT_NAME=ForenSight

# CORS
# Comma-separated list of allowed origins. Use * for development.
BACKEND_CORS_ORIGINS=*

# Database
# Use absolute path or relative path to the SQLite database
# SQLALCHEMY_DATABASE_URI=sqlite:///./sql_app.db

# Storage
# Absolute path to the storage directory
# FORENSIGHT_STORAGE_PATH=D:\Project Resume\ForenSight\storage

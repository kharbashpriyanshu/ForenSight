# ForenSight V2.1 — Backend Configuration Template
# Copy this file to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=ForenSight
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Local Development (SQLite default):
DATABASE_URL=sqlite:///./forensight.db

# Production Deployment (PostgreSQL):
# DATABASE_URL=postgresql://forensight:<DB_PASSWORD>@localhost:5432/forensight
# Inside Docker Compose:
# DATABASE_URL=postgresql://forensight:forensight_password@db:5432/forensight

# -----------------------------------------------------------------------------
# Celery Worker & Redis Message Broker
# -----------------------------------------------------------------------------
# Local Development Fallback (synchronous in-process execution without Redis):
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production / Docker Worker Mode (true async worker with Redis broker):
# CELERY_TASK_ALWAYS_EAGER=false
# Inside Docker Compose:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# WARNING: The default secret key MUST be replaced with a strong random string
# in any production deployment (e.g. openssl rand -hex 32).
SECRET_KEY=a_very_secret_key_for_jwt_auth_replace_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# CORS & Storage
# -----------------------------------------------------------------------------
# CORS: comma-separated origins or * for local development
BACKEND_CORS_ORIGINS=*
STORAGE_DIR=storage/evidence
MAX_UPLOAD_SIZE=10485760
